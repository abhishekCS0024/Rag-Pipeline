# ============================================================
# APPLICATION
# ============================================================

APP_NAME=rag-platform
APP_ENV=development
APP_DEBUG=true

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO


# ============================================================
# STREAMLIT
# ============================================================

STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# When running everything locally without Docker:
API_BASE_URL=http://localhost:8000

# When Streamlit runs inside Docker Compose, use:
# API_BASE_URL=http://api:8000


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag

# Inside Docker Compose use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rag


# ============================================================
# DATABASE CONNECTION POOL
# ============================================================

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# ============================================================
# PGVECTOR
# ============================================================

PGVECTOR_ENABLED=true

# Must match the selected embedding model.
EMBEDDING_DIMENSION=1536

# cosine | l2 | inner_product
VECTOR_DISTANCE=cosine


# ============================================================
# POSTGRESQL FULL-TEXT SEARCH
# ============================================================

FTS_LANGUAGE=english


# ============================================================
# HYBRID RETRIEVAL
# ============================================================

DENSE_TOP_K=20
SPARSE_TOP_K=20

# Number of results retained after fusion
FUSION_TOP_K=30

# Reciprocal Rank Fusion constant
RRF_K=60

# Number of chunks retained after reranking
RERANK_TOP_K=5

RERANKING_ENABLED=true


# ============================================================
# DOCUMENT INGESTION
# ============================================================

MAX_UPLOAD_SIZE_MB=100

ALLOWED_FILE_TYPES=pdf,docx,pptx,txt

# Maximum documents processed concurrently by a worker
INGESTION_CONCURRENCY=2


# ============================================================
# CHUNKING
# ============================================================

CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Keep enough metadata to trace chunks back to the source.
INCLUDE_PAGE_METADATA=true
INCLUDE_SECTION_METADATA=true


# ============================================================
# DOCLING
# ============================================================

DOCLING_ENABLED=true

DOCLING_OCR_ENABLED=true
DOCLING_TABLE_STRUCTURE_ENABLED=true


# ============================================================
# RABBITMQ
# ============================================================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

RABBITMQ_VHOST=/

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Docker Compose:
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/


# ============================================================
# RABBITMQ TOPOLOGY
# ============================================================

RABBITMQ_DOCUMENT_EXCHANGE=rag.documents

RABBITMQ_PROCESS_QUEUE=rag.document.processing
RABBITMQ_REINDEX_QUEUE=rag.document.reindex
RABBITMQ_DELETE_QUEUE=rag.document.delete

RABBITMQ_PROCESS_ROUTING_KEY=document.process
RABBITMQ_REINDEX_ROUTING_KEY=document.reindex
RABBITMQ_DELETE_ROUTING_KEY=document.delete


# ============================================================
# RABBITMQ DEAD LETTER / RETRY
# ============================================================

RABBITMQ_DLQ=rag.document.dlq
RABBITMQ_RETRY_QUEUE=rag.document.retry

RABBITMQ_MAX_RETRIES=3

# milliseconds
RABBITMQ_RETRY_DELAY_MS=5000

RABBITMQ_PREFETCH_COUNT=2


# ============================================================
# REDIS
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_PASSWORD=

REDIS_URL=redis://localhost:6379/0

# Docker Compose:
# REDIS_URL=redis://redis:6379/0


# ============================================================
# REDIS CACHE
# ============================================================

CACHE_ENABLED=true

QUERY_EMBEDDING_CACHE_TTL=86400

RETRIEVAL_CACHE_TTL=600

RESPONSE_CACHE_TTL=300


# ============================================================
# REDIS DISTRIBUTED LOCKS
# ============================================================

DOCUMENT_LOCK_TTL=1800

DOCUMENT_LOCK_PREFIX=lock:document


# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_ENABLED=true

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60


# ============================================================
# OBJECT STORAGE
# ============================================================

# local | minio | s3
STORAGE_PROVIDER=minio

S3_BUCKET=rag-documents
S3_REGION=us-east-1

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

S3_ENDPOINT=http://localhost:9000

# Docker Compose:
# S3_ENDPOINT=http://minio:9000

S3_USE_SSL=false


# ============================================================
# LOCAL STORAGE
# Used only when STORAGE_PROVIDER=local
# ============================================================

LOCAL_STORAGE_PATH=./data/uploads


# ============================================================
# EMBEDDING PROVIDER
# ============================================================

# Example:
# openai | huggingface | local
EMBEDDING_PROVIDER=openai

EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_API_KEY=

EMBEDDING_BATCH_SIZE=32


# ============================================================
# RERANKER
# ============================================================

# cohere | local | none
RERANKER_PROVIDER=none

RERANKER_MODEL=

RERANKER_API_KEY=


# ============================================================
# LLM
# ============================================================

# openai | anthropic | gemini | local
LLM_PROVIDER=openai

LLM_MODEL=

LLM_API_KEY=

LLM_TEMPERATURE=0.1

LLM_MAX_TOKENS=2048

LLM_TIMEOUT_SECONDS=60


# ============================================================
# RAG GENERATION
# ============================================================

MAX_CONTEXT_CHUNKS=5

MAX_CONTEXT_TOKENS=8000

RETURN_CITATIONS=true


# ============================================================
# AUTHENTICATION
# ============================================================

AUTH_ENABLED=false

JWT_SECRET_KEY=change-this-in-production

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:8501


# ============================================================
# OBSERVABILITY
# ============================================================

OTEL_ENABLED=false

OTEL_SERVICE_NAME=rag-api

OTEL_EXPORTER_OTLP_ENDPOINT=


# ============================================================
# REQUEST / TRACE
# ============================================================

REQUEST_ID_HEADER=X-Request-ID


# ============================================================
# DEVELOPMENT
# ============================================================

SQL_ECHO=false

ENABLE_API_DOCS=true